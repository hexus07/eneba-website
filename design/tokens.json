{
  "$description": "Design tokens extracted from the eneba.com html.to.design import (Figma file jaipl50e6EpTMnsmzMTzD2). Format: W3C Design Tokens (DTCG). Values marked $extensions.merged absorb near-duplicates found in the import. Third-party brand colors (Trustpilot, Visa, PayPal, Mastercard, Google, app stores) and the Eneba logo gradients are intentionally excluded.",
  "color": {
    "$type": "color",
    "bg": {
      "base": { "$value": "#4618AC", "$description": "Page background (every screen)" },
      "header": { "$value": "#351183", "$description": "Checkout header bar, tab bar", "$extensions": { "merged": ["#3C1395", "#3D1596"] } }
    },
    "surface": {
      "raised": { "$value": "#45229C", "$description": "Secondary nav bar, inputs, side panels" },
      "card": { "$value": "#1F0A4D", "$description": "Product card body, offer rows, card borders" },
      "footer": { "$value": "#160850", "$description": "Footer, login background. Close to surface/card but visibly darker; kept separate" },
      "tab": { "$value": "#5825CC", "$description": "Active tab (product description tabs)" }
    },
    "overlay": {
      "band": { "$value": "#0000004D", "$description": "Full-bleed band behind 'Top games' (black 30%)" },
      "scrim": { "$value": "#0000008C", "$description": "Card platform bar (black 55%) + background blur 10" }
    },
    "accent": {
      "DEFAULT": { "$value": "#FAD318", "$description": "Primary buttons, links, checkboxes", "$extensions": { "merged": ["#FAC917"] } },
      "cashback": { "$value": "#63E3C2", "$description": "Cashback badge background, product card border" }
    },
    "success": { "$value": "#23C299", "$description": "Checkout stepper, verified seller, success text", "$extensions": { "merged": ["#00CF9F", "#3DDCB3"] } },
    "danger": { "$value": "#D32252", "$description": "Sale / Black Week accents" },
    "text": {
      "primary": { "$value": "#FFFFFF" },
      "secondary": { "$value": "#FFFFFFD9", "$description": "White 85%" },
      "tertiary": { "$value": "#FFFFFFB3", "$description": "White 70%", "$extensions": { "merged": ["#FFFFFF99 (white 60%)"] } },
      "disabled": { "$value": "#FFFFFF66", "$description": "White 40% (inactive stepper step)" },
      "subtle": { "$value": "#DCD8E6", "$description": "Card meta text", "$extensions": { "merged": ["#DCDCE6"] } },
      "muted": { "$value": "#B3AAC9", "$description": "Labels, 'From'", "$extensions": { "merged": ["#A09AAC", "#9385B2"] } },
      "cashback": { "$value": "#84E916", "$description": "Cashback amounts", "$extensions": { "merged": ["#9FEE49"] } },
      "region": { "$value": "#E76A8C", "$description": "Region label, activation warnings" },
      "notice": { "$value": "#FEF8DC", "$description": "Important notice text" },
      "onAccent": { "$value": "{color.surface.card}", "$description": "Text on yellow buttons" }
    },
    "border": {
      "default": { "$value": "#FFFFFF", "$description": "Outline buttons (1-2px)" },
      "subtle": { "$value": "#FFFFFF1F", "$description": "Dividers (white 12%)" },
      "card": { "$value": "{color.accent.cashback}", "$description": "Product card 1px border" }
    }
  },
  "radius": {
    "$type": "dimension",
    "none": { "$value": "0px", "$description": "Cards, buttons, panels (Eneba is square)" },
    "xs": { "$value": "2px", "$description": "Payment chips, checkbox", "$extensions": { "merged": ["1px", "3px"] } },
    "sm": { "$value": "4px", "$description": "Trustpilot frame, nav promo pills", "$extensions": { "merged": ["5px", "6px"] } },
    "md": { "$value": "10px", "$description": "Genre tags, 'Lowest price' badge" },
    "full": { "$value": "9999px", "$description": "Avatars, stepper dots, pills (source values 8/12/20/35/50 were all height/2)" }
  },
  "space": {
    "$type": "dimension",
    "$description": "Eneba uses a 5px rhythm (15 card padding, 20 card gap, 30/40 section spacing) plus a few 4px-grid values. Outliers 3, 7, 14 and 19 are import noise.",
    "2": { "$value": "2px" },
    "4": { "$value": "4px" },
    "5": { "$value": "5px" },
    "8": { "$value": "8px" },
    "10": { "$value": "10px" },
    "12": { "$value": "12px" },
    "15": { "$value": "15px", "$description": "Card padding" },
    "20": { "$value": "20px", "$description": "Card gap, panel padding" },
    "24": { "$value": "24px" },
    "30": { "$value": "30px" },
    "40": { "$value": "40px", "$description": "Panel padding (large)" },
    "50": { "$value": "50px", "$description": "Section spacing" }
  },
  "font": {
    "family": { "$type": "fontFamily", "base": { "$value": ["Metropolis", "Inter", "system-ui", "sans-serif"], "$description": "Metropolis (eneba.com, confirmed in DevTools); public domain (Unlicense), self-hosted via @fontsource/metropolis" } },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 400 },
      "medium": { "$value": 500 },
      "semibold": { "$value": 600 },
      "bold": { "$value": 700 },
      "extrabold": { "$value": 800 },
      "black": { "$value": 900 }
    }
  },
  "text": {
    "$type": "typography",
    "display": { "$value": { "fontFamily": "{font.family.base}", "fontWeight": 800, "fontSize": "88px", "lineHeight": "88px" }, "$description": "Login hero" },
    "h1": { "$value": { "fontFamily": "{font.family.base}", "fontWeight": 700, "fontSize": "26px", "lineHeight": "32.5px" }, "$description": "Product title" },
    "h2": { "$value": { "fontFamily": "{font.family.base}", "fontWeight": 700, "fontSize": "30px", "lineHeight": "37.5px" }, "$description": "Home section titles" },
    "h2Sm": { "$value": { "fontFamily": "{font.family.base}", "fontWeight": 700, "fontSize": "18px", "lineHeight": "22.5px" }, "$description": "Product/cart section titles" },
    "priceXl": { "$value": { "fontFamily": "{font.family.base}", "fontWeight": 800, "fontSize": "30px", "lineHeight": "30px" }, "$description": "Cart total, featured offer price" },
    "priceLg": { "$value": { "fontFamily": "{font.family.base}", "fontWeight": 800, "fontSize": "22px", "lineHeight": "22px" }, "$description": "Card price", "$extensions": { "merged": ["21.1-21.8px"] } },
    "titleCard": { "$value": { "fontFamily": "{font.family.base}", "fontWeight": 800, "fontSize": "12px", "lineHeight": "18px" }, "$description": "Product card title", "$extensions": { "merged": ["11.6px", "11.8px"] } },
    "body": { "$value": { "fontFamily": "{font.family.base}", "fontWeight": 400, "fontSize": "14px", "lineHeight": "21px" } },
    "bodySm": { "$value": { "fontFamily": "{font.family.base}", "fontWeight": 400, "fontSize": "12px", "lineHeight": "18px" } },
    "label": { "$value": { "fontFamily": "{font.family.base}", "fontWeight": 600, "fontSize": "12px", "lineHeight": "18px" } },
    "caption": { "$value": { "fontFamily": "{font.family.base}", "fontWeight": 800, "fontSize": "12px", "lineHeight": "12px" }, "$description": "'From', region", "$extensions": { "merged": ["11.1-11.8px"] } },
    "badge": { "$value": { "fontFamily": "{font.family.base}", "fontWeight": 800, "fontSize": "10px", "lineHeight": "10px", "textTransform": "uppercase" }, "$description": "Cashback badge", "$extensions": { "merged": ["9.8px"] } },
    "button": { "$value": { "fontFamily": "{font.family.base}", "fontWeight": 800, "fontSize": "15px", "lineHeight": "15px" }, "$extensions": { "merged": ["14.5-14.9px"] } }
  },
  "shadow": {
    "$type": "shadow",
    "panel": { "$value": { "offsetX": "0px", "offsetY": "3px", "blur": "9px", "spread": "0px", "color": "#00000040" }, "$description": "Side panels", "$extensions": { "merged": ["black 40%"] } },
    "popup": { "$value": { "offsetX": "0px", "offsetY": "-4px", "blur": "20px", "spread": "0px", "color": "#000000B3" } }
  },
  "blur": {
    "$type": "dimension",
    "scrim": { "$value": "10px", "$description": "Backdrop blur on card platform bar" }
  }
}
